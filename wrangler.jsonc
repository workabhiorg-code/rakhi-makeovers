{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rakhi-makeovers",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",
      "node_modules/**",
      "scripts",
      "scripts/**",
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      "package.json",
      "package-lock.json",
      ".cfignore",
      ".wranglerignore",
      "wrangler.jsonc",
      "wrangler.toml",
      "*.log"
    ]
  }
}
