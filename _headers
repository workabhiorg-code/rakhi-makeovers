# Cloudflare Pages Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Global Security & Core Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'none';

# Admin Dashboard Security & Indexing Protection
/login/Rakhi
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, no-cache, must-revalidate

/login/Rakhi/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, no-cache, must-revalidate

/login/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, no-cache, must-revalidate

/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, no-cache, must-revalidate

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, no-cache, must-revalidate

# Static Assets (Images, WebP, PNG, SVG, Favicons, Fonts) - 1 Year Cache
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.*
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json; charset=utf-8

# CSS & JavaScript - 1 Week Cache with Stale While Revalidate
/assets/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# SEO Crawling Directives & Feeds
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# HTML Pages - Always Fresh / Fast Revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Dynamic API Routes - Serverless Functions with CORS
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

# JSON Data Static Fallbacks
/data/services.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/data/gallery.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/data/reviews.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/data/admin.json
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive
