{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rakhi-makeovers",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
